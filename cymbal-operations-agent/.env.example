# ==============================================================================
# Cymbal Retail Operations Agent - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your target Google Cloud environment.
# Example: cp .env.example .env

# --- Google Cloud Platform Environment ---
PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
REGION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Foundation LLM Configuration ---
COORDINATOR_MODEL=gemini-3.6-flash

# --- BigQuery Conversational Data Agent Configuration ---
DATA_AGENT_ID=your-data-agent-uuid
DATA_AGENT_RESOURCE_NAME=projects/your-gcp-project-id/locations/global/dataAgents/your-data-agent-uuid
DATA_AGENT_LOCATION=global

# --- Cloud Bigtable & MCP Microservice Configuration ---
BIGTABLE_INSTANCE_ID=operations-db
BIGTABLE_TABLE_ID=cashier_realtime_alerts
BIGTABLE_MCP_URL=https://mcp-toolbox-bigtable-your-service-hash.a.run.app

# --- Vector Search & RAG Diagnostic Configuration ---
SIMILARITY_THRESHOLD=0.70
BIGLAKE_CONNECTION_ID=your-gcp-project-id.us-central1.biglake-iceberg-connection

# --- BigQuery Agent Analytics Telemetry ---
BQ_TELEMETRY_DATASET=agent_telemetry
